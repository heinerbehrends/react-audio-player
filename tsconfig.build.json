{
  "compilerOptions": {
    /* Base options */
    "target": "ES2022",
    /* Not for anything in this repo: tsup 8.5.1's dts pipeline injects a
       `baseUrl`, which TypeScript 6 deprecates and 7 removes. Without this the
       dts build fails with TS5101 and ships no types at all. It buys TS 6 and
       defers the problem — TS 7 breaks the build regardless of the flag, so it
       comes off when tsup stops injecting `baseUrl`. See issues/. */
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "isolatedModules": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "declaration": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
