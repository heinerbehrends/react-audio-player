{
  "name": "react-audio-player",
  "version": "0.0.0",
  "type": "module",
  "description": "A headless React audio player library",
  "keywords": [
    "react",
    "audio",
    "player",
    "headless",
    "react-audio-player"
  ],
  "homepage": "https://github.com/heinerbehrends/react-audio-player",
  "bugs": "https://github.com/heinerbehrends/react-audio-player/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/heinerbehrends/react-audio-player.git"
  },
  "author": "Heiner Behrends <heiner@heinerbehrends.com>",
  "license": "MIT",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "vite": "vite dev",
    "build": "tsup",
    "lint": "eslint .",
    "preview": "vite preview",
    "testE2E": "playwright test",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "check-exports": "attw --pack ."
  },
  "peerDependencies": {
    "react": ">=16.3.0",
    "react-dom": ">=16.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.1",
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.28",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./volume": {
      "types": "./dist/volume.d.ts",
      "import": "./dist/volume.mjs",
      "default": "./dist/volume.mjs"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.mjs",
      "default": "./dist/timeline.mjs"
    },
    "./captions": {
      "types": "./dist/captions.d.ts",
      "import": "./dist/captions.mjs",
      "default": "./dist/captions.mjs"
    },
    "./playback-rate": {
      "types": "./dist/playback-rate.d.ts",
      "import": "./dist/playback-rate.mjs",
      "default": "./dist/playback-rate.mjs"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "import": "./dist/player.mjs",
      "default": "./dist/player.mjs"
    },
    "./time-display": {
      "types": "./dist/time-display.d.ts",
      "import": "./dist/time-display.mjs",
      "default": "./dist/time-display.mjs"
    }
  }
}
