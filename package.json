{
  "name": "react-headless-audio-player",
  "version": "0.1.0-beta.0",
  "type": "module",
  "description": "A headless React audio player library",
  "keywords": [
    "react",
    "audio",
    "player",
    "headless",
    "react-headless-audio-player"
  ],
  "homepage": "https://github.com/heinerbehrends/react-audio-player",
  "bugs": "https://github.com/heinerbehrends/react-audio-player/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/heinerbehrends/react-audio-player.git"
  },
  "author": "Heiner Behrends <heiner@heinerbehrends.com>",
  "license": "MIT",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm type-check && pnpm build",
    "vite": "vite dev",
    "build": "tsup",
    "lint": "eslint .",
    "preview": "vite preview",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "testE2E": "playwright test",
    "testE2E:local": "playwright test --config playwright.local.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "pnpm tsc7 --noEmit --project tsconfig.app.json && pnpm tsc7 --noEmit --project tsconfig.test.json && pnpm tsc7 --noEmit --project tsconfig.node.json && pnpm tsc7 --noEmit --project tsconfig.demo.json",
    "tsc7": "node node_modules/typescript-7/bin/tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-exports": "attw --pack . --profile esm-only --exclude-entrypoints styles.css",
    "size": "node scripts/bundle-size.mjs",
    "issues": "node scripts/issues.mjs",
    "issues:check": "node scripts/issues.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.27.7",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.44.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  }
}
